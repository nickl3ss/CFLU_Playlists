__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/settings.json
.vscode/launch.json

# Generierte Playlist-Exports
Playlists/

