keyvault/anthropic_api_key.txt
keyvault/lastfm_api_key.txt
keyvault/lastfm_api_secret.txt
keyvault/DB.txt

# Last.fm metadata cache (auto-generated, not a secret)
cflu_lastfm.json


# Check-script für Webspace als Test für Transformation auf Webspace (lokal, nicht ins Repo)
check.php

# Quelldaten (Datenschutz — nicht ins Repo)
Spotify_Source.xlsx
*.xlsx
*.csv
# Everynoise reference data — tracked for reproducible offline builds
!data/everynoise_genre_attrs.csv

# Generierte Datenbasis (aus Build-Script erzeugt)
cflu_tracks.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/settings.json
.vscode/launch.json

# Generierte Playlist-Exports
Playlists/

# Claude Code — root CLAUDE.md ist getrackt; lokale Override-Dateien bleiben lokal
docs/CLAUDE.md
_fix_issues.py
.claude/

# Archivierte Dateien — lokal als Referenz, nicht im Repo
archive/
/Methodik/

# Interne Entwicklungs-Prompts
